# Copie privée : cp backup-evidence.env.example backup-evidence.env
# Ne jamais inclure ce fichier rempli dans une archive ou un dépôt Git.
# Chaque référence doit désigner une sauvegarde réelle, vérifiée et conservée hors du cluster.
ETCD_SNAPSHOT_REFERENCE="A_COMPLETER: nom + emplacement externe du snapshot etcd K3s"
CNPG_BACKUP_REFERENCE="A_COMPLETER: identifiant de sauvegarde CNPG/Barman ou stockage externe"
CNPG_DUMP_FILE="A_COMPLETER: chemin absolu du dump généré par 02-backup-postgres.sh"
CNPG_DUMP_SHA256="A_COMPLETER: SHA-256 affiché par 02-backup-postgres.sh"
LONGHORN_BACKUP_REFERENCE="A_COMPLETER: identifiant de backup Longhorn sur cible externe"
RESTORE_TESTED="no"
OPERATOR="A_COMPLETER"
