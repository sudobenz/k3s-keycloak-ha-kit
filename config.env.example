# Kit AUTONOME K3s HA + Keycloak. Adapter les valeurs au matériel et au réseau.
# Aucun secret ne doit être placé dans ce fichier.

# ---- Nœuds K3s ----
NODE1_NAME="k3s-1"
NODE1_IP="192.0.2.51"
NODE2_NAME="k3s-2"
NODE2_IP="192.0.2.52"
NODE3_NAME="k3s-3"
NODE3_IP="192.0.2.53"

# ---- K3s / réseau ----
K3S_VERSION="v1.36.6+k3s1"
K3S_POD_CIDR="10.42.0.0/16"
K3S_SERVICE_CIDR="10.43.0.0/16"
K3S_LOCAL_STORAGE_PATH="/var/lib/rancher/k3s/storage"
K3S_API_VIP="192.0.2.54"
INGRESS_VIP="192.0.2.55"
KUBEVIP_INTERFACE="ens18"
KUBEVIP_VERSION="v1.3.1"
HELM_VERSION="v4.3.1"
KUBECONFIG="/etc/rancher/k3s/k3s.yaml"

# ---- Versions épinglées ----
LONGHORN_VERSION="1.13.0"
CNPG_VERSION="1.30.1"
POSTGRES_IMAGE="ghcr.io/cloudnative-pg/postgresql:18.6-system-trixie"
CERT_MANAGER_VERSION="v1.21.3"
KEYCLOAK_VERSION="26.8.2"
KEYCLOAK_OPERATOR_REF="26.8.2"

# ---- Namespaces / Traefik ----
KEYCLOAK_NAMESPACE="keycloak"
CNPG_NAMESPACE="cnpg-system"
CERT_MANAGER_NAMESPACE="cert-manager"
INGRESS_CLASS="traefik"
TRAEFIK_NAMESPACE="kube-system"
TRAEFIK_ENABLE_HTTP="false" # false = HTTPS uniquement ; DNS-01 conseillé pour ACME

# ---- Longhorn ----
LONGHORN_DATA_PATH="/var/lib/longhorn"
LONGHORN_REQUIRE_MOUNT="true"
LONGHORN_FQDN="longhorn.example.com"
PG_STORAGE_CLASS="longhorn-pg-local"
PG_STORAGE_SIZE="20Gi"

# ---- CloudNativePG / PostgreSQL dédié Keycloak ----
CNPG_CLUSTER_NAME="keycloak-db"
CNPG_INSTANCES="3"
PG_SYNC_MODE="preferred" # async | preferred | required
PG_CPU_REQUEST="1"
PG_MEMORY_REQUEST="1Gi"
PG_MAX_CONNECTIONS="150"
KEYCLOAK_DB_NAME="keycloak"
KEYCLOAK_DB_USER="keycloak"
KEYCLOAK_DB_SECRET="keycloak-db-credentials"

# ---- Keycloak ----
KEYCLOAK_NAME="keycloak"
KEYCLOAK_FQDN="keycloak.example.com"
KEYCLOAK_REPLICAS="3"
KEYCLOAK_DB_POOL_MAX="30"
KEYCLOAK_CPU_REQUEST="500m"
KEYCLOAK_MEMORY_REQUEST="1700Mi"
KEYCLOAK_CPU_LIMIT="2"
KEYCLOAK_MEMORY_LIMIT="2Gi"

# ---- TLS ----
# selfsigned : certificat autosigné de bootstrap ; files : PEM existants ; cert-manager : Certificate/Issuer existant
KEYCLOAK_TLS_MODE="selfsigned" # selfsigned | files | cert-manager
KEYCLOAK_TLS_SECRET="keycloak-tls"
CERT_FILE=""
KEY_FILE=""
CERT_VALIDITY_DAYS="365"
TLS_FORCE_REPLACE="false"
CERT_MANAGER_ISSUER_NAME="" # requis si KEYCLOAK_TLS_MODE=cert-manager
CERT_MANAGER_ISSUER_KIND="ClusterIssuer" # Issuer | ClusterIssuer
CERT_MANAGER_CERT_DURATION="2160h"
CERT_MANAGER_RENEW_BEFORE="360h"

# ---- Headlamp optionnel (lecture par défaut, sans cluster-admin) ----
HEADLAMP_INSTALL="false"
HEADLAMP_NAMESPACE="headlamp"
HEADLAMP_RELEASE="my-headlamp"
HEADLAMP_CHART_VERSION="0.46.0"
HEADLAMP_FQDN="headlamp.example.com" # réservé pour une éventuelle exposition ultérieure

# ---- Portainer Edge Agent optionnel ----
PORTAINER_NAMESPACE="portainer"
PORTAINER_USE_PROXY="false"

# ---- Proxy d'entreprise facultatif ----
HTTP_PROXY=""
HTTPS_PROXY=""
NO_PROXY=""
CORPORATE_CA_FILE=""

# Protection hôte : renseigner les IP/CIDR réels d'administration avant Fail2ban.
# Exemple de syntaxe uniquement : "192.0.2.10/32,192.0.2.0/24,2001:db8::/64"
FAIL2BAN_IGNORE_IPS=""
# "ssh" si port standard; sinon numéro TCP du port sshd réellement utilisé.
FAIL2BAN_SSH_PORT="ssh"
